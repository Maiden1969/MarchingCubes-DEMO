#pragma kernel MarchingCubes

cbuffer MarchingCubeParams
{
    float size;
    uint resolution;
    uint maxVertices;
    uint bricksPerAxis;
}

// 稀疏砖存储(BrickMap): 每块 32³ 格切成 4×4×4 个 8³ 体素的砖。
// BRICK_INDIRECTION[bx + bpa*(by + bpa*bz)] = 紧凑砖 ID(0..N-1);
// >= 0xFFFFFFFE = 缺砖(砖内无表面,全实体/全空气)→ 格子直接跳过。
// BRICK_DATA 砖池布局: brickID*729 + lz*81 + ly*9 + lx(local 角点 0..8)。
StructuredBuffer<uint> BRICK_INDIRECTION;
StructuredBuffer<float> BRICK_DATA;

StructuredBuffer<uint> edgeTable;
StructuredBuffer<int> triTable;

RWStructuredBuffer<float3> Vertices;
RWStructuredBuffer<float3> Normals;
RWStructuredBuffer<uint> Triangles;
RWStructuredBuffer<uint> Counters;


// from iq
// deprecated
// float3 CalcNormal(float3 p){
//    float3 n = float3(0.0, 0.0, 0.0);
//    for( int i = 0; i < 4; i++)
//    {
//       float3 e = 0.5773 * 2.0 * float3((i+3>>1&1) - 0.5, (i>>1&1) - 0.5,(i&1) - 0.5);
//       n += e * SDScene(p + 0.0005*e);
//    }
//    return normalize(n);
// }

// for convenience of loop
static const uint LoopTable0[4 ] = {0, 1, 1, 0 };
static const uint LoopTable1[12] = { 0, 1, 2, 3, 4, 5, 6, 7, 0, 1, 2, 3 };
static const uint LoopTable2[12] = { 1, 2, 3, 0 ,5, 6, 7, 4, 4, 5, 6, 7 };

// 砖几何(与DS/BrickGrid.cs 的常量一致)
static const uint kBrickSize = 8;                 // 砖宽(体素)
static const uint kBrickValues = 9;               // 每轴角点数 = kBrickSize + 1
static const uint kBrickValueCount = 729;         // 9³


[numthreads(4,4,4)]
void MarchingCubes (uint3 id : SV_DispatchThreadID)
{
    uint i = id.x;
    uint j = id.y;
    uint k = id.z;

    if (i >= resolution || j >= resolution || k >= resolution) return;

    // 所在砖: 缺砖 = 砖内无表面,无需发射三角形。halo 砖无表面格,state 恒 0/255,
    // 走下面的 edgeTable[state] == 0 提前返回(与缺砖跳过一致)。
    uint brickID = BRICK_INDIRECTION[(i >> 3) + bricksPerAxis * ((j >> 3) + bricksPerAxis * (k >> 3))];
    if (brickID >= 0xFFFFFFFEu) return;

    float voxel_size = size / float(resolution);
    uint state = 0;
    float3 positions[8];
    float  values[8];

    [unroll]
   // compute the voxel
    for (uint m = 0; m < 8; ++m)
    {
        positions[m] =
            float3(
                -(size / 2.0) + (i + ((m/4)&1)) * voxel_size,
                -(size / 2.0) + (j + 1 - ((m/2)&1)) * voxel_size,
                -(size / 2.0) + (k + LoopTable0[m&3]) * voxel_size
                );

        // 角的砖局部坐标 0..8(角 x = i+1 ≤ 32 时仍在同一砖内: 32 & 7 = 0 但砖取 i>>3,
        // i ≤ 31 故局部 = (i&7)+1 ≤ 8,不会跨界读邻砖)。
        uint3 corner = uint3((i & 7) + ((m/4)&1), (j & 7) + 1 - ((m/2)&1), (k & 7) + LoopTable0[m&3]);
        values[m] = BRICK_DATA[brickID * kBrickValueCount +
                               corner.z * kBrickValues * kBrickValues + corner.y * kBrickValues + corner.x];

        if (values[m] < 0.0)
            state |= 1 << m;
    }

   // no intersection
    if (edgeTable[state] == 0) return;

   // use edgeTable to find && compute the intersections
    float3 vertList[12];

    [unroll]
    for (int n = 0; n < 12; ++n)
        if ((edgeTable[state] & 1 << n) != 0)
        {
            int s1 = LoopTable1[n];
            int s2 = LoopTable2[n];

           // ensure the same point of different voxel mapping to the same position
            if ((positions[s1] - positions[s2]).x > 0.0)
            {
                int temp = s1;
                s1 = s2;
                s2 = temp;
            }

           // avoid NaN
            if (abs(values[s1]) < 0.0002)
            {
               vertList[n] = positions[s1];
            }
            else if (abs(values[s2]) < 0.0002)
            {
               vertList[n] = positions[s2];
            }
           // now values[s1] - values[s2] can't be 0
            else
            {
               float t = values[s1] / (values[s1] - values[s2]);
               vertList[n] = lerp(positions[s1], positions[s2], t);
            }
        }

   // use triTable to assemble triangles
    for (int s = 0; s < 16; s += 3)
    {
        int triIndex = state * 16 + s;
        if (triTable[triIndex] == -1) break;

        int v0 = triTable[triIndex + 0];
        int v1 = triTable[triIndex + 1];
        int v2 = triTable[triIndex + 2];

        uint baseIndex;
        InterlockedAdd(Counters[0], 3, baseIndex);

        if (baseIndex + 2 < maxVertices)
        {
            Vertices[baseIndex + 0] = vertList[v0];
            Vertices[baseIndex + 1] = vertList[v2];
            Vertices[baseIndex + 2] = vertList[v1];

            uint baseTriIndex;
            InterlockedAdd(Counters[1], 3, baseTriIndex);
            Triangles[baseTriIndex + 0] = baseIndex + 0;
            Triangles[baseTriIndex + 1] = baseIndex + 1;
            Triangles[baseTriIndex + 2] = baseIndex + 2;
        }
    }
}
